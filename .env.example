# Secrets and provider settings. Copy to .env (gitignored) and fill in.
# Everything that is not a secret belongs in config.yaml instead.
#
# All LLM calls (embeddings, rerank, chat) go through one OpenAI-compatible provider,
# chosen by which API key is set: fill in ONE of the two blocks below. If both keys
# are set, LLM_PROVIDER (marketplace | openrouter) must say which to use.
# LLM_PROVIDER=

# --- AI Marketplace (corporate LiteLLM gateway) ---------------------------------
# https://marketplace.novo-genai.com/api/ ; model ids:
# https://marketplace.novo-genai.com/model/model-cards/
# or `curl -H "Authorization: Bearer $KEY" https://api.marketplace.novo-genai.com/v1/models`.

# Your AI Marketplace API token (the same one Claude Code uses as ANTHROPIC_AUTH_TOKEN).
MARKETPLACE_API_KEY=

# Embedding model. Changing it requires `vault-spider sync --reset`.
MARKETPLACE_EMBEDDING_MODEL=openai_text_embedding_3_small

# Used for synthesis and the enrichment planner. Pin a specific id rather than a
# `_latest` alias -- the Marketplace moves aliases without notice.
MARKETPLACE_CHAT_MODEL=anthropic_claude_sonnet_5_5

# Optional and used only with index.context_source: openrouter.
# Defaults to MARKETPLACE_CHAT_MODEL.
MARKETPLACE_CONTEXT_MODEL=anthropic_claude_haiku_5_5

# Optional. Enables reranking in `--mode thorough`; without it, thorough
# behaves like fast plus recency.
MARKETPLACE_RERANK_MODEL=cohere_rerank_3_5

# Texts per embeddings request (default 32). gemini_embedding_2 on the Marketplace
# returns one vector for a whole list, so it needs 1.
# MARKETPLACE_EMBEDDING_BATCH_SIZE=32

# Optional. Defaults are fine for most setups.
# MARKETPLACE_BASE_URL=https://api.marketplace.novo-genai.com/v1
# MARKETPLACE_APP_TITLE=Vault Spider
# LiteLLM drops per-model unsupported chat parameters (e.g. temperature on
# Claude 5.x) instead of failing the request. Default true.
# MARKETPLACE_DROP_PARAMS=true

# --- OpenRouter ------------------------------------------------------------------
# https://openrouter.ai/keys . Same settings with the OPENROUTER_ prefix; defaults:
# embedding openai/text-embedding-3-small, chat openai/gpt-4o-mini,
# base URL https://openrouter.ai/api/v1, DROP_PARAMS false.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_CONTEXT_MODEL=
# OPENROUTER_RERANK_MODEL=cohere/rerank-v3.5
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=Vault Spider
